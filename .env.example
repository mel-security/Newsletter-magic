# ── Timezone ──────────────────────────────────────────────
TZ=Africa/Tunis

# ── Ollama / LLM ─────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
MODEL_WRITER=mistral
MODEL_CRITIC=deepseek-r1:7b
OLLAMA_KEEP_ALIVE=0

# ── Scheduler ─────────────────────────────────────────────
DAILY_RUN_TIME=06:30

# ── SMTP ──────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
FROM_EMAIL=cyberagent@local.dev
TO_EMAILS=admin@local.dev

# ── MailHog (local testing) ───────────────────────────────
MAILHOG_ENABLED=true

# ── Pipeline ──────────────────────────────────────────────
MAX_ARTICLES_PER_RUN=200
MAX_STORIES=25
LANG=fr

# ── Search engines (Google, Google News, Bing) ───────────
# Enable autonomous web searching beyond RSS feeds
SEARCH_ENABLED=true
# Active search profile(s) — comma-separated, from config/search_profiles.yml
# Available: cybersecurity, ai_security, cloud_infra, privacy, iot_security, fintech, tech_general
SEARCH_PROFILE=cybersecurity
# Auto-discover new prompt injection techniques and update blacklist
BLACKLIST_AUTO_UPDATE=true

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=cyberagent
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=cyberagent
DATABASE_URL=postgresql+asyncpg://cyberagent:changeme_in_production@postgres:5432/cyberagent
DATABASE_URL_SYNC=postgresql://cyberagent:changeme_in_production@postgres:5432/cyberagent

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
LOG_FORMAT=json
